[Unit]
Description=Dronestock shared manual and Offboard horizontal LiDAR observations
After=dronestock-manual-observe.service dronestock-manual-lidar.service

[Service]
Type=simple
EnvironmentFile=%h/.config/dronestock/lidar-velocity.env
ExecStart=/usr/bin/env bash ${ROS2_WORKSPACE}/src/drone_uwb/deployment/run_lidar_velocity.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=default.target

+// Explicit -P -C maintenance startup only. No repeated EEPROM writes for -P.
+int TF02PRO::configure_tfmini_plus()
+{
+	const uint8_t commands[2][6] = {
+		{0x5A, 0x06, 0x35, 0x00, 0x00, 0x95}, // low-power mode off
+		{0x5A, 0x06, 0x03, 0x64, 0x00, 0xC7}  // internal measurement 100Hz
+	};
+	for (const auto &command : commands) {
+		uint8_t reply[6] {};
+		if (transfer(command, sizeof(command), nullptr, 0) != PX4_OK) { return PX4_ERROR; }
+		px4_usleep(100000); // configuration ACK delay, never the distance polling loop
+		if (transfer(nullptr, 0, reply, sizeof(reply)) != PX4_OK) { return PX4_ERROR; }
+		for (unsigned i = 0; i < sizeof(reply); ++i) {
+			if (reply[i] != command[i]) { return PX4_ERROR; }
+		}
+	}
+	const uint8_t save[] = {0x5A, 0x04, 0x11, 0x6F};
+	uint8_t reply[5] {};
+	if (transfer(save, sizeof(save), nullptr, 0) != PX4_OK) { return PX4_ERROR; }
+	px4_usleep(100000);
+	if (transfer(nullptr, 0, reply, sizeof(reply)) != PX4_OK
+	    || reply[0] != 0x5A || reply[1] != 5 || reply[2] != 0x11
+	    || reply[3] != 0 || reply[4] != 0x70) { return PX4_ERROR; }
+	px4_usleep(1000000); // manufacturer save-settling requirement, once with -C
+	return PX4_OK;
+}
+
+void TF02PRO::run_tfmini_plus()
+{
+	constexpr uint32_t poll_us = 20000;
+	if (!_collect_phase) {
+		_request_time = hrt_absolute_time();
+		if (measure() != PX4_OK) { ScheduleDelayed(poll_us); return; }
+		_collect_phase = true;
+		_read_attempts = 0;
+	}
+	// Distance request permits immediate read. A transient NACK/frame error
+	// gets at most two nonblocking 1ms retries, never a catch-up burst.
+	if (collect() != PX4_OK && ++_read_attempts < 3) {
+		ScheduleDelayed(1000);
+		return;
+	}
+	_collect_phase = false;
+	const hrt_abstime elapsed = hrt_absolute_time() - _request_time;
+	ScheduleDelayed(elapsed < poll_us ? poll_us - elapsed : poll_us);
+}

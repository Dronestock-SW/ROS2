+bool TF02PRO::configuration_disarmed()
+{
+	vehicle_status_s status{};
+	const auto now = hrt_absolute_time();
+	return _vehicle_status_sub.copy(&status) && status.timestamp > 0 && status.timestamp <= now
+	       && now - status.timestamp <= 1500000
+	       && status.arming_state == vehicle_status_s::ARMING_STATE_DISARMED;
+}
+
+void TF02PRO::configuration_failed()
+{
+	++_config_errors;
+	_config_state = ConfigState::Failed;
+	ScheduleClear();
+	PX4_ERR("TFmini Plus configuration failed; no ranging, stop/start required");
+}
+
+bool TF02PRO::write_configuration(const uint8_t *command, size_t size)
+{
+	if (transfer(command, size, nullptr, 0) != PX4_OK) {
+		perf_count(_comms_errors);
+		configuration_failed();
+		return false;
+	}
+
+	return true;
+}
+
+bool TF02PRO::read_configuration(const uint8_t *expected, size_t size)
+{
+	uint8_t reply[6]{};
+
+	if (size > sizeof(reply) || transfer(nullptr, 0, reply, size) != PX4_OK) {
+		perf_count(_comms_errors);
+		configuration_failed();
+		return false;
+	}
+
+	if (!tfmini_plus::ack_matches(reply, expected, size)) {
+		configuration_failed();
+		return false;
+	}
+
+	return true;
+}
+
+void TF02PRO::run_configuration()
+{
+	if (!configuration_disarmed()) {
+		configuration_failed();
+		return;
+	}
+
+	switch (_config_state) {
+	case ConfigState::Normal:
+		if (write_configuration(tfmini_plus::NORMAL_MODE, sizeof(tfmini_plus::NORMAL_MODE))) {
+			_config_state = ConfigState::NormalAck;
+			ScheduleDelayed(tfmini_plus::CONFIG_WAIT_US);
+		}
+
+		return;
+	case ConfigState::NormalAck:
+		if (!read_configuration(tfmini_plus::NORMAL_MODE, sizeof(tfmini_plus::NORMAL_MODE))) { return; }
+
+		_config_state = ConfigState::Rate;
+		break;
+	case ConfigState::Rate:
+		if (write_configuration(tfmini_plus::RATE_100_HZ, sizeof(tfmini_plus::RATE_100_HZ))) {
+			_config_state = ConfigState::RateAck;
+			ScheduleDelayed(tfmini_plus::CONFIG_WAIT_US);
+		}
+
+		return;
+	case ConfigState::RateAck:
+		if (!read_configuration(tfmini_plus::RATE_100_HZ, sizeof(tfmini_plus::RATE_100_HZ))) { return; }
+
+		_config_state = ConfigState::Save;
+		break;
+	case ConfigState::Save:
+		if (write_configuration(tfmini_plus::SAVE, sizeof(tfmini_plus::SAVE))) {
+			_config_state = ConfigState::SaveAck;
+			ScheduleDelayed(tfmini_plus::SAVE_WAIT_US);
+		}
+
+		return;
+	case ConfigState::SaveAck:
+		if (!read_configuration(tfmini_plus::SAVE_OK, sizeof(tfmini_plus::SAVE_OK))) { return; }
+
+		_configuration_acknowledged = true;
+		_config_state = ConfigState::Ready;
+		_next_poll = hrt_absolute_time();
+		PX4_INFO("TFmini Plus normal/100Hz/save ACK received; power-cycle verification still required");
+		break;
+	default: return;
+	}
+
+	ScheduleNow();
+}
+
+void TF02PRO::run_tfmini_plus()
+{
+	if (_config_state == ConfigState::Failed) { return; }
+
+	if (_config_state != ConfigState::Ready) {
+		run_configuration();
+		return;
+	}
+
+	const auto now = hrt_absolute_time();
+
+	if (now < _next_poll) {
+		ScheduleAt(_next_poll);
+		return;
+	}
+
+	_last_schedule_late_us = now - _next_poll;
+	if (_last_schedule_late_us > _max_schedule_late_us) { _max_schedule_late_us = _last_schedule_late_us; }
+
+	// The TFmini Plus manual permits reading immediately after the result request.
+	// Never collect an old response after a failed request or retry in an unbounded loop.
+	const bool valid = measure() == PX4_OK && collect() == PX4_OK;
+	_last_transaction_us = hrt_absolute_time() - now;
+	if (_last_transaction_us > _max_transaction_us) { _max_transaction_us = _last_transaction_us; }
+	_consecutive_failures = valid ? 0 : _consecutive_failures + 1;
+
+	if (_consecutive_failures == 5) {
+		PX4_WARN("TFmini Plus: 5 consecutive invalid/missing samples; inspect status counters");
+	}
+
+	_next_poll = tfmini_plus::next_deadline(_next_poll, hrt_absolute_time(), _skipped_slots);
+	ScheduleAt(_next_poll);
+}

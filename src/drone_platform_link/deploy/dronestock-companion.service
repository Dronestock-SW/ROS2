[Unit]
Description=DroneStock Platform communication only
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/.local/share/dronestock-companion
EnvironmentFile=%h/.config/dronestock-companion/companion.env
Environment=PYTHONPATH=%h/.local/share/dronestock-companion/app:%h/.local/share/dronestock-companion/deps
Environment=PYTHONUTF8=1
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=ROS_DOMAIN_ID=1
ExecStart=/usr/bin/python3 -m drone_platform_link.runtime
Restart=always
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target

# Copy outside Git to ~/.config/dronestock/manual-capture.env; use absolute paths.
ROS2_WORKSPACE=/home/arialhanho/ROS2-review-20261008-codex
MANUAL_CAPTURE_ROOT=/home/arialhanho/.local/share/dronestock/manual-captures
MANUAL_TAG=B
# Optional /scan and TF recording; does not start a LiDAR driver or aid PX4.
MANUAL_CAPTURE_LIDAR=0
# Enable dronestock-manual-lidar.service separately after checking USB identity.
MANUAL_LIDAR_PREFIX=/home/arialhanho/ROS2-integration-20261007/install/ydlidar_ros2_driver
MANUAL_LIDAR_PARAMS=/home/arialhanho/ROS2-review-20261008-codex/src/drone_bringup/params/lidar_tmini.yaml
MANUAL_BTF_CONFIG=/home/arialhanho/ROS2-review-20261008-codex/.review/field-20261009/field-btf.json
MANUAL_ANCHORS=/home/arialhanho/ROS2-review-20261008-codex/src/drone_uwb/config/anchors/anchors_20261016_z2p1.json
MANUAL_PYTHON_DEPS=/home/arialhanho/ROS2-integration-20261007/.test-deps

+++ b/src/drivers/distance_sensor/tf02pro/TFMiniPlus.hpp
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// TFmini Plus I2C profile. No device access or assumed physical timestamp here.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace tfmini_plus
+{
+constexpr uint32_t POLL_US = 20000;
+constexpr uint32_t CONFIG_WAIT_US = 100000;
+constexpr uint32_t SAVE_WAIT_US = 1000000;
+constexpr uint8_t NORMAL_MODE[] = {0x5a, 0x06, 0x35, 0x00, 0x00, 0x95};
+constexpr uint8_t RATE_100_HZ[] = {0x5a, 0x06, 0x03, 0x64, 0x00, 0xc7};
+constexpr uint8_t SAVE[] = {0x5a, 0x04, 0x11, 0x6f};
+constexpr uint8_t SAVE_OK[] = {0x5a, 0x05, 0x11, 0x00, 0x70};
+
+inline uint8_t checksum(const uint8_t *bytes, size_t count)
+{
+	uint8_t sum = 0;
+
+	for (size_t i = 0; i < count; ++i) {
+		sum = static_cast<uint8_t>(sum + bytes[i]);
+	}
+
+	return sum;
+}
+
+inline bool ack_matches(const uint8_t *reply, const uint8_t *expected, size_t size)
+{
+	return size >= 4 && reply[0] == 0x5a && reply[1] == size
+	       && reply[size - 1] == checksum(reply, size - 1)
+	       && std::memcmp(reply, expected, size) == 0;
+}
+
+enum class FrameError { None, Header, Checksum, Signal, Range };
+
+inline FrameError decode(const uint8_t (&frame)[9], uint16_t &distance_mm, uint16_t &strength)
+{
+	if (frame[0] != 0x59 || frame[1] != 0x59) {
+		return FrameError::Header;
+	}
+
+	if (checksum(frame, 8) != frame[8]) {
+		return FrameError::Checksum;
+	}
+
+	strength = static_cast<uint16_t>((frame[5] << 8) | frame[4]);
+	distance_mm = static_cast<uint16_t>((frame[3] << 8) | frame[2]);
+
+	if (strength < 100 || strength == 65535) {
+		return FrameError::Signal;
+	}
+
+	if (distance_mm < 100 || distance_mm > 12000) {
+		return FrameError::Range;
+	}
+
+	return FrameError::None;
+}
+
+// Advance the original cadence, skipping missed slots instead of bursting.
+inline uint64_t next_deadline(uint64_t previous, uint64_t now, uint32_t &skipped)
+{
+	uint64_t next = previous + POLL_US;
+
+	if (next <= now) {
+		const uint64_t missed = (now - next) / POLL_US + 1;
+		skipped += static_cast<uint32_t>(missed);
+		next += missed * POLL_US;
+	}
+
+	return next;
+}
+} // namespace tfmini_plus

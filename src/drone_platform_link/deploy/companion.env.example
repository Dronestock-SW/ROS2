DRONESTOCK_SERVER_URL=http://203.247.41.82:8001
DRONESTOCK_DRONE_ID=5
DRONESTOCK_COMPANION_ID=jetson-drone-05
DRONESTOCK_POLL_S=0.5
DRONESTOCK_TELEMETRY_HZ=10
DRONESTOCK_DEVICE_AUTH_ID=
DRONESTOCK_DEVICE_AUTH_SECRET=

# Onboard ROS domain: 1 for Tag A (5), 2 for Tag B (6).
# DRONESTOCK_DRONE_ID is the web enrollment ID, not automatically the Tag ID.
ROS_DOMAIN_ID=1
DRONESTOCK_POSE_SOURCE=btf_xy
DRONESTOCK_MISSION_POLL_ENABLED=false
# Choices: uwb_xy, btf_xy, px4_local (local ENU only; warehouse transform pending).
# Signed observation WebSocket requires both device credentials and web enrollment.
# The LoRa ground USB receiver runs separately on the local web PC.

[Unit]
Description=Sangwon web transport (live API read-only observation)
Wants=sangwon-core.service
After=sangwon-core.service
PartOf=sangwon-autonomy.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/Desktop/ROS2/src/sangwon_AI
ExecStart=/bin/bash %h/Desktop/ROS2/src/sangwon_AI/deployment/run_web.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
UMask=0077
Environment=PYTHONUTF8=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=sangwon-autonomy.target

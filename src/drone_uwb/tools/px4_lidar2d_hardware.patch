new file mode 100644
index 0000000000..7b6d4a153c
--- /dev/null
+++ b/msg/LidarVelocity2d.msg
@@ -0,0 +1,11 @@
+# Experimental independent horizontal LiDAR observation at the IMU origin.
+# No vertical position, velocity, attitude, or angular rate is observed.
+uint64 timestamp
+uint64 timestamp_sample
+float32[2] velocity_ne
+float32[3] covariance_ne # [var_n, cov_ne, var_e], (m/s)^2
+uint8 reset_counter
+int8 quality
+uint8 source_system
+uint8 source_component
+bool frame_valid

<?xml version="1.0"?>
<package format="3">
  <name>drone_mission</name>
  <version>0.1.0</version>
  <description>Bounded web flight trials using PX4 takeoff, reposition and landing.</description>
  <maintainer email="user@todo.todo">Dronestock</maintainer>
  <license>Proprietary</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geographic_msgs</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>drone_uwb</exec_depend>
  <exec_depend>drone_demo</exec_depend>
  <exec_depend>drone_platform_link</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
